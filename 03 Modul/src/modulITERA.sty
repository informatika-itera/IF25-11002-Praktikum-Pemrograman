% ---- judul bagian: label kecil, judul Poppins, garis emas-merah
\newcommand\Bagian[2]{\par\needspace{9\baselineskip}\vspace{14pt}%
  {\ITERAKicker\fontsize{8.5pt}{10pt}\selectfont\color{ITERAGoldText}\MakeUppercase{#1}\par}\vspace{2pt}%
  {\ITERADisplay\bfseries\fontsize{19pt}{24pt}\selectfont\color{ITERAStructure}#2\par}\vspace{4pt}%
  {\color{ITERAGold}\rule{30pt}{3pt}}{\color{ITERARed}\rule{9pt}{3pt}}\par\vspace{6pt}}
\newcommand\Sub[1]{\par\needspace{5\baselineskip}\vspace{8pt}{\ITERADisplay\bfseries\fontsize{12.5pt}{16pt}\selectfont\color{ITERAStructure}#1\par}\vspace{2pt}}
% ---- kotak berlabel
\tcbset{ITERAkotak/.style={enhanced,breakable,arc=0pt,boxrule=0pt,left=12pt,right=12pt,top=9pt,bottom=9pt,before skip=10pt,after skip=10pt,fontupper=\raggedright}}
\newcommand\Label[2]{{\ITERAKicker\fontsize{7.5pt}{9pt}\selectfont\color{#1}#2}}
\newtcolorbox{Tebak}[1][]{ITERAkotak,colback=ITERAAlert50,before upper={\Label{ITERAAlert}{TEBAK DULU}\ifx\relax#1\relax\else\ \ {\bfseries #1}\fi\par\vspace{3pt}}}
\newtcolorbox{Jawaban}[1][]{ITERAkotak,colback=ITERASukses50,before upper={\Label{ITERASukses}{JAWABAN}\ifx\relax#1\relax\else\ \ {\bfseries #1}\fi\par\vspace{3pt}}}
\newtcolorbox{Penting}[1][]{ITERAkotak,colback=ITERAGold50,borderline west={3pt}{0pt}{ITERAGold},before upper={\Label{ITERAGoldText}{PENTING}\ifx\relax#1\relax\else\ \ {\bfseries #1}\fi\par\vspace{3pt}}}
\newtcolorbox{Contoh}[1][]{ITERAkotak,colback=ITERANeutral50,borderline west={3pt}{0pt}{ITERAStructure},before upper={\Label{ITERAStructure}{CONTOH}\ifx\relax#1\relax\else\ \ {\bfseries #1}\fi\par\vspace{3pt}}}
% ---- kode dan keluaran
\lstdefinestyle{ITERACode}{language=C++,basicstyle=\ttfamily\fontsize{9.5pt}{13.5pt}\selectfont\color{ITERAInk},keywordstyle=\color{CodeKeyword}\bfseries,
  stringstyle=\color{CodeString},commentstyle=\color{CodeComment}\itshape,numbers=none,showstringspaces=false,columns=fixed,keepspaces=true,
  upquote=true,tabsize=4,morekeywords={include,using,namespace,cout,cin,endl,std,string,getline}}
\lstdefinestyle{ITERAPlain}{basicstyle=\ttfamily\fontsize{9.5pt}{13.5pt}\selectfont\color{ITERAInk},columns=fixed,keepspaces=true,showstringspaces=false,upquote=true,tabsize=8}
\newtcblisting{MKode}[2][]{enhanced,breakable,arc=0pt,colback=white,colframe=ITERARule,boxrule=0.6pt,colbacktitle=ITERAGold,coltitle=ITERAInk,
  title={#2},fonttitle=\ttfamily\fontsize{8.5pt}{10pt}\selectfont,toptitle=3pt,bottomtitle=3pt,left=10pt,top=6pt,bottom=6pt,
  before skip=10pt,after skip=10pt,listing only,listing options={style=ITERACode},#1}
\newtcblisting{MKeluaran}[1][]{enhanced,breakable,arc=0pt,colback=ITERANeutral50,colframe=ITERANeutral50,boxrule=0pt,colbacktitle=ITERAGround,coltitle=ITERAGold,
  title={Keluaran},fonttitle=\ITERADisplay\bfseries\fontsize{8.5pt}{10pt}\selectfont,toptitle=3pt,bottomtitle=3pt,left=10pt,top=6pt,bottom=6pt,
  before skip=8pt,after skip=10pt,listing only,listing options={style=ITERAPlain},#1}
